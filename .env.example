# ==================================================
# CAPACITY CONNECT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before running the application
# DO NOT commit real secrets or credentials to Git
# ==================================================

# Database (PostgreSQL / Supabase compatible)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=capacity_connect
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capacity_connect

# Backend App Settings
APP_NAME="Capacity Connect API"
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Security (Placeholder for JWT / RBAC in later phases)
SECRET_KEY=dev-insecure-secret-key-change-this-in-production-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend App Settings
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Future Cloud/Storage (Supabase Storage / OAuth placeholders)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
