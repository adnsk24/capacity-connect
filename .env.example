# ==================================================
# CAPACITY CONNECT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before running the application
# DO NOT commit real secrets or credentials to Git
# ==================================================

# Database (PostgreSQL / Supabase compatible)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=capacity_connect
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capacity_connect

# Backend App Settings
APP_NAME="Capacity Connect API"
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Security & Authentication (JWT)
SECRET_KEY=dev-insecure-secret-key-change-this-in-production-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=https://capacity-connect.pages.dev,http://localhost:5173
FRONTEND_URL=https://capacity-connect.pages.dev

# Frontend App Settings (Cloudflare Pages)
VITE_API_BASE_URL=https://capacity-connect-backend.onrender.com/api/v1

# Supabase Storage & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_MEDIA_BUCKET=course-media
SUPABASE_STORAGE_CERTIFICATES_BUCKET=certificates

# AI Intelligence Layer (Phase 7 - Zero-cost/Optional)
AI_ENABLED=true
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash
AI_API_KEY=
AI_BASE_URL=

