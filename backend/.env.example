# ==============================================================
# Capacity Connect - Backend Environment Variables Template
# ==============================================================

# Application Configuration
APP_NAME="Capacity Connect API"
APP_VERSION="0.1.0"
ENVIRONMENT=production
DEBUG=False
HOST=0.0.0.0
# PORT is dynamically assigned by Render in production (e.g. 10000)
PORT=8000

# Database Configuration (Supabase PostgreSQL)
# Example Supabase pooled connection string:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capacity_connect

# Security & Authentication (JWT)
# Generate a strong 64-char random key for production (e.g. openssl rand -hex 32)
SECRET_KEY=change-this-to-a-strong-random-secret-key-for-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_HOURS=2
REQUIRE_ADMIN_APPROVAL=True

# CORS Configuration
# Comma-separated list of allowed frontend origins (e.g. Cloudflare Pages + local dev)
BACKEND_CORS_ORIGINS=https://capacity-connect.pages.dev,http://localhost:5173

# Frontend Public URL (Used for Certificate Verification QR Codes)
FRONTEND_URL=https://capacity-connect.pages.dev

# Supabase Cloud Storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_STORAGE_MEDIA_BUCKET=course-media
SUPABASE_STORAGE_CERTIFICATES_BUCKET=certificates

# AI Intelligence Layer (Phase 7 - Zero-cost/Optional)
AI_ENABLED=true
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash
AI_API_KEY=
AI_BASE_URL=

