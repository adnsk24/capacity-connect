# Capacity Connect - Backend Environment Variables
APP_NAME="Capacity Connect API"
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capacity_connect

# Security (Phase 2)
SECRET_KEY=dev-insecure-secret-key-change-this-in-production-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
